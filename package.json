{
  "name": "formforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "start:all": "bash scripts/start-all.sh",
    "stop:all": "bash scripts/stop-all.sh",
    "worker": "node --import tsx scripts/worker.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "mcp": "node --import tsx scripts/mcp-stdio.ts",
    "mcp:client": "node --import tsx scripts/mcp-client.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "agent:ui": "node --import tsx scripts/ui-agent.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p .",
    "check": "npm run typecheck && npm run lint && npm test",
    "postinstall": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.108",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@scalar/api-reference": "^1.76.4",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.162",
    "better-sqlite3": "^13.0.3",
    "bowser": "^2.15.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.10.3",
    "disposable-email-domains": "^1.0.62",
    "geoip-lite": "^2.0.3",
    "lucide-react": "^1.68.0",
    "marked": "^18.1.3",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "openai": "^7.50.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "valyu-js": "^2.11.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "msw": "^3.0.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
